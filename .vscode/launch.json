        {
            "name": "STM32 Debug (DAP)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/RM26_H7.elf",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/stm32h7x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32H723VGTx",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
            // "svdFile": "${workspaceFolder}/STM32H7.svd"
        },

        {
            "name": "STM32 Debug (STLink)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/RM26_H7.elf",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32h7x.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32H723VGTx",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 20
            },
            // "svdFile": "${workspaceFolder}/STM32H7.svd"
        },

    ]
}